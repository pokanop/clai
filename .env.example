# Copy to .env and load in your shell if you use dotenv tooling.
# clai reads Hugging Face and cloud settings via env; see `figment` CLAI__ prefix in config.

# HF_TOKEN=
# CLAI_CLOUD__ENABLED=true
# CLAI_CLOUD__BASE_URL=https://api.openai.com/v1
# CLAI_CLOUD__API_KEY_ENV=OPENAI_API_KEY
# CLAI_CLOUD__MODEL=gpt-4o-mini

# GPU offload for embedded llama (layer count; 0 = CPU only)
# CLAI_N_GPU_LAYERS=0

# Interactive local sessions: optional eager GGUF load before the first prompt (off | blocking; default off)
# CLAI_INTERACTIVE__LOCAL_WARMUP=off

# Self-update repo (defaults: pokanop/clai)
# CLAI_UPDATE_REPO_OWNER=
# CLAI_UPDATE_REPO_NAME=
# CLAI_UPDATE_TARGET=x86_64-unknown-linux-gnu
# CLAI_UPDATE_BIN_PATH_IN_ARCHIVE={{ bin }}

# Cloud: disable if API rejects json_schema response_format
# CLAI_CLOUD__STRUCTURED_OUTPUTS=false

# Registry fetch URL for `clai models update-registry`
# CLAI_REGISTRY_URL=

# Ollama HTTP API for `clai models ollama` (discovery only)
# CLAI_OLLAMA_HOST=http://127.0.0.1:11434

# Extra GGUF catalog rows in config.toml (merged with built-in + cached registry):
# [[models.extra]]
# id = "my-model"
# display_name = "My GGUF"
# profile = "custom"
# hf_repo = "username/repo-GGUF"
# filename = "Model-Q4_K_M.gguf"
# ram_hint_gb = 12
